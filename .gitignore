# 依赖
node_modules

# Nuxt / Nitro 构建产物
.nuxt
.output
.nitro
.cache
dist

# 环境变量：含 JWT_SECRET / DATABASE_URL，禁止入库
.env
.env.*
!.env.example

# 数据库文件（本地 SQLite，各环境独立）
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# 审计截图（体积大，属过程产物，不入库；报告本身仍保留在 docs/）
docs/ui-audit-2026-10-15/

# WorkBuddy 项目记忆（本机上下文，不入库）
.workbuddy-ai/

# 编辑器 / 操作系统
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
*.swp

# 生产密钥文件（PM2 ecosystem 读取，绝不入库）
ecosystem.env.cjs
