# 统一换行符为 LF，避免 Windows / macOS 协作时产生整文件 diff
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.xlsx binary
*.db binary

# 语言标注（影响 GitHub 语言统计与 diff 高亮）
*.vue linguist-language=Vue
*.ts linguist-language=TypeScript
*.mjs linguist-language=JavaScript
*.cjs linguist-language=JavaScript
*.css linguist-language=CSS
*.prisma linguist-language=Prisma
